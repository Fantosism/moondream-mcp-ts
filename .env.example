# Moondream MCP TypeScript Configuration
# Copy this file to .env and customize the values for your environment

# =============================================================================
# MODEL EXECUTION MODE
# =============================================================================

# Model execution mode: local, cloud, or hybrid
MOONDREAM_MODEL_MODE=hybrid

# Cloud API settings (required for cloud/hybrid modes)
# MOONDREAM_API_KEY=your_api_key_here
# MOONDREAM_API_ENDPOINT=https://api.moondream.ai/v1

# =============================================================================
# LOCAL MODEL SETTINGS
# =============================================================================

# Model identifier from Hugging Face
MOONDREAM_MODEL_NAME=vikhyatk/moondream2

# Model revision/version 
MOONDREAM_MODEL_REVISION=2025-01-09

# Allow execution of remote code (required for most models)
MOONDREAM_TRUST_REMOTE_CODE=true

# Directory to cache downloaded models
MOONDREAM_MODEL_CACHE_DIR=/tmp/moondream_models

# Timeout for downloading models (seconds)
MOONDREAM_MODEL_DOWNLOAD_TIMEOUT_SECONDS=300

# Timeout for loading models into memory (seconds)
MOONDREAM_MODEL_LOAD_TIMEOUT_SECONDS=120

# Enable model warmup on startup
MOONDREAM_ENABLE_MODEL_WARMUP=true

# Timeout for model warmup (seconds)
MOONDREAM_MODEL_WARMUP_TIMEOUT_SECONDS=30

# =============================================================================
# DEVICE AND MEMORY SETTINGS
# =============================================================================

# Device type: cpu, cuda, mps, or auto
MOONDREAM_DEVICE=auto

# GPU memory fraction (0.1-1.0, only used with CUDA/MPS)
MOONDREAM_GPU_MEMORY_FRACTION=0.8

# System memory limit in MB
MOONDREAM_MEMORY_LIMIT_MB=4096

# =============================================================================
# IMAGE PROCESSING SETTINGS
# =============================================================================

# Maximum image dimensions (width x height)
MOONDREAM_MAX_IMAGE_SIZE=2048

# Maximum file size in MB
MOONDREAM_MAX_FILE_SIZE_MB=50

# Maximum total pixels (prevents very large images)
MOONDREAM_MAX_IMAGE_PIXELS=33177600

# Enable image preprocessing
MOONDREAM_IMAGE_PREPROCESSING_ENABLED=true

# Image resize quality: low, medium, high
MOONDREAM_IMAGE_RESIZE_QUALITY=high

# JPEG compression quality (1-100)
MOONDREAM_IMAGE_COMPRESSION_QUALITY=85

# Enable automatic image optimization
MOONDREAM_ENABLE_IMAGE_OPTIMIZATION=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# General operation timeout (seconds)
MOONDREAM_TIMEOUT_SECONDS=120

# Maximum concurrent requests
MOONDREAM_MAX_CONCURRENT_REQUESTS=5

# Enable streaming responses
MOONDREAM_ENABLE_STREAMING=true

# Maximum batch size for batch operations
MOONDREAM_MAX_BATCH_SIZE=10

# Batch processing concurrency
MOONDREAM_BATCH_CONCURRENCY=3

# Enable batch progress reporting
MOONDREAM_ENABLE_BATCH_PROGRESS=true

# Batch operation timeout (seconds)
MOONDREAM_BATCH_TIMEOUT_SECONDS=600

# Number of worker threads
MOONDREAM_WORKER_THREADS=4

# Enable memory monitoring
MOONDREAM_ENABLE_MEMORY_MONITORING=true

# Memory warning threshold in MB
MOONDREAM_MEMORY_WARNING_THRESHOLD_MB=3072

# =============================================================================
# NETWORK SETTINGS
# =============================================================================

# HTTP request timeout (seconds)
MOONDREAM_REQUEST_TIMEOUT_SECONDS=30

# Maximum HTTP redirects to follow
MOONDREAM_MAX_REDIRECTS=5

# User agent string for HTTP requests
MOONDREAM_USER_AGENT=Moondream-MCP-TS/1.0.0

# Connection timeout (seconds)
MOONDREAM_CONNECT_TIMEOUT_SECONDS=10

# Read timeout (seconds)
MOONDREAM_READ_TIMEOUT_SECONDS=30

# Number of retry attempts for failed requests
MOONDREAM_RETRY_ATTEMPTS=3

# Backoff delay between retries (seconds)
MOONDREAM_RETRY_BACKOFF_SECONDS=2

# Enable SSL certificate verification
MOONDREAM_ENABLE_SSL_VERIFICATION=true

# HTTP proxy URL (optional)
# MOONDREAM_PROXY_URL=http://proxy.example.com:8080

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Enable CORS support
MOONDREAM_ENABLE_CORS=false

# Allowed CORS origins (comma-separated)
# MOONDREAM_CORS_ORIGINS=https://example.com,https://app.example.com

# Enable rate limiting
MOONDREAM_ENABLE_RATE_LIMITING=true

# Rate limit: requests per minute
MOONDREAM_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Enable request validation
MOONDREAM_ENABLE_REQUEST_VALIDATION=true

# Maximum request size in MB
MOONDREAM_MAX_REQUEST_SIZE_MB=100

# Enable input sanitization
MOONDREAM_ENABLE_SANITIZATION=true

# Blocked domains (comma-separated)
# MOONDREAM_BLOCKED_DOMAINS=malicious.com,spam.net

# Allowed domains (comma-separated, empty = allow all)
# MOONDREAM_ALLOWED_DOMAINS=trusted.com,safe.org

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

# Log level: debug, info, warn, error
MOONDREAM_LOG_LEVEL=info

# Log format: json, text, structured
MOONDREAM_LOG_FORMAT=structured

# Log file path (optional, logs to console if not set)
# MOONDREAM_LOG_FILE_PATH=/var/log/moondream.log

# Enable performance logging
MOONDREAM_ENABLE_PERFORMANCE_LOGGING=true

# Enable access logging
MOONDREAM_ENABLE_ACCESS_LOGGING=true

# =============================================================================
# CACHE SETTINGS
# =============================================================================

# Enable caching
MOONDREAM_ENABLE_CACHING=true

# Cache type: memory, redis, file
MOONDREAM_CACHE_TYPE=memory

# Cache TTL in seconds
MOONDREAM_CACHE_TTL_SECONDS=3600

# Cache maximum size in MB
MOONDREAM_CACHE_MAX_SIZE_MB=1024

# Enable model caching
MOONDREAM_ENABLE_MODEL_CACHING=true

# Enable result caching
MOONDREAM_ENABLE_RESULT_CACHING=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable debug mode
MOONDREAM_DEBUG_MODE=false

# Enable debug logging
MOONDREAM_ENABLE_DEBUG_LOGGING=false

# Save debug images to disk
MOONDREAM_SAVE_DEBUG_IMAGES=false

# Debug images directory
MOONDREAM_DEBUG_IMAGE_DIR=/tmp/debug_images

# Enable mock mode (uses fake responses)
MOONDREAM_MOCK_MODE=false

# Mock response delay in milliseconds
MOONDREAM_MOCK_DELAY_MS=100