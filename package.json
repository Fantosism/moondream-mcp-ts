{
  "name": "moondream-mcp-ts",
  "version": "0.1.0",
  "description": "TypeScript implementation of Moondream MCP Server using BOBA-T framework",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node -r tsconfig-paths/register dist/main.js",
    "mcp": "ts-node -r tsconfig-paths/register src/main.ts",
    "dev": "ts-node -r tsconfig-paths/register",
    "clean": "rm -rf dist",
    "test": "npm run test-real-api",
    "test-real-api": "ts-node -r tsconfig-paths/register test-real-api.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "moondream",
    "mcp",
    "vision",
    "ai",
    "typescript",
    "boba-t",
    "image-analysis"
  ],
  "author": "Fantosism",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fantosism/moondream-mcp-ts.git"
  },
  "homepage": "https://github.com/Fantosism/moondream-mcp-ts#readme",
  "bugs": {
    "url": "https://github.com/Fantosism/moondream-mcp-ts/issues"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "3.0.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "boba-t": "^1.0.1",
    "dotenv": "^17.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.12",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
